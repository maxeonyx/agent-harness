#!/usr/bin/env bash
# A long-lived brain on an installed build of a commit.
#
#   dev/serve NAME PORT [HARNESS-BRAIN FLAG...]
#
# Runs this clone's HEAD (a tree with uncommitted changes is refused) as
# the user unit harness-NAME.service on
# ~/.local/share/agent-harness/NAME/brain.sqlite. The builds limb does the
# work (crates/limb-builds), so there is one way to install and relaunch:
#
# - If the unit does not run, it installs the commit (`harness-limb-builds
#   install`: its executables and roles/ into
#   ~/.local/share/agent-harness/builds/COMMIT/, once, read-only, deleting
#   the builds nothing runs or links to but the three newest) and starts
#   it with that build's roles and any further flags (`--model scripted`,
#   `--sample WAV`). It prints the commit and the URL once the brain serves
#   its face.
# - If it runs, it relaunches it, as the `relaunch` tool does, with the
#   running build's own builds limb: the brain drains (its requests in
#   flight get up to five minutes), the new build starts on the same
#   database with the same flags, and it waits until the build is proven
#   (a response, and a call a limb settled, in its span) or has gone back
#   to the build before. It keeps the flags the brain runs with: stop
#   the unit to change them. A running build older than the builds limb is relaunched by
#   this clone's.
#
# ~/.local/share/agent-harness/NAME/build links to the build a restart of
# NAME runs, the last proven, so its `act` is
# ~/.local/share/agent-harness/NAME/build/bin/act.
# Its log: journalctl --user -u harness-NAME.
set -euo pipefail

die() { echo "dev/serve: $*" >&2; exit 1; }

[[ $# -ge 2 ]] || die "usage: dev/serve NAME PORT [HARNESS-BRAIN FLAG...]"
name=$1 port=$2
shift 2
[[ $name =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "NAME is lowercase letters, digits and -: $name"
[[ $port =~ ^[0-9]+$ ]] || die "PORT is a number: $port"

repo=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
cd "$repo"
unit=harness-$name.service
home=${XDG_DATA_HOME:-$HOME/.local/share}/agent-harness

if systemctl --user -q is-active "$unit"; then
    [[ $# -eq 0 ]] || echo "dev/serve: $unit keeps the flags it runs with; stop it to change them" >&2
    pid=$(systemctl --user show -p MainPID --value "$unit")
    limb=$(dirname "$(readlink -f "/proc/$pid/exe")")/harness-limb-builds
    if [[ ! -x $limb ]]; then
        cargo build -q --release -p harness-limb-builds
        limb=$repo/target/release/harness-limb-builds
    fi
    exec "$limb" relaunch "$unit" "$repo"
fi

cargo build -q --release -p harness-limb-builds
build=$("$repo/target/release/harness-limb-builds" install "$repo")
commit=${build##*/}
data=$home/$name
mkdir -p "$data"
[[ -z $(ss -Hltn "sport = :$port") ]] || die "something else listens on port $port"
ln -sfn "$build" "$data/build"
"$build/bin/harness-limb-builds" start "$unit" "$build/bin/harness-brain" \
    --db "$data/brain.sqlite" --port "$port" --roles "$build/roles" "$@"

url=https://mx-hv-mj.local:$port/
for _ in $(seq 120); do
    source=$(curl -sk --max-time 2 "https://localhost:$port/view" | jq -r .rows.harness.Harness.source 2>/dev/null) || true
    if [[ $source == "$commit" ]]; then
        echo "$name runs $commit at $url"
        exit 0
    fi
    systemctl --user -q is-active "$unit" || break
    sleep 0.5
done
journalctl --user -u "$unit" -n 20 --no-pager >&2
die "$unit did not serve $commit at $url"
